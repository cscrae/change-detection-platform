# Optional reference basemap. Empty values use OpenStreetMap's standard XYZ.
# VITE_* is public browser configuration. Never put private credentials here.
VITE_BASEMAP_URL=
VITE_BASEMAP_CRS=
VITE_BASEMAP_DATUM=
VITE_BASEMAP_ATTRIBUTION=
VITE_BASEMAP_MAX_NATIVE_ZOOM=

# Custom example (replace with an authorized standard XYZ service):
# VITE_BASEMAP_URL=https://maps.example.org/tiles/{z}/{x}/{y}.png
# VITE_BASEMAP_CRS=EPSG:3857
# VITE_BASEMAP_DATUM=WGS84
# VITE_BASEMAP_ATTRIBUTION=Authorized map provider
# VITE_BASEMAP_MAX_NATIVE_ZOOM=19
