FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Public build-time map settings. Never pass private keys through VITE_*.
ARG VITE_BASEMAP_URL=""
ARG VITE_BASEMAP_CRS=""
ARG VITE_BASEMAP_DATUM=""
ARG VITE_BASEMAP_ATTRIBUTION=""
ARG VITE_BASEMAP_MAX_NATIVE_ZOOM=""
ENV VITE_BASEMAP_URL=${VITE_BASEMAP_URL} \
    VITE_BASEMAP_CRS=${VITE_BASEMAP_CRS} \
    VITE_BASEMAP_DATUM=${VITE_BASEMAP_DATUM} \
    VITE_BASEMAP_ATTRIBUTION=${VITE_BASEMAP_ATTRIBUTION} \
    VITE_BASEMAP_MAX_NATIVE_ZOOM=${VITE_BASEMAP_MAX_NATIVE_ZOOM}
RUN npm run build

FROM nginx:1.28-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/local-proxy.sh /docker-entrypoint.d/40-local-proxy.sh
RUN chmod +x /docker-entrypoint.d/40-local-proxy.sh
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
