# Example Linux host paths; replace with the target server's actual paths.
# Copy to server.env for local use only; never publish the filled configuration.
# All directories must exist before compose starts.
# SERVER_IMAGERY_DIR is the test_up directory inside the mounted read-only share.
SERVER_IMAGERY_DIR=/mnt/transit/hebei/test_up
SERVER_CATALOG_DIR=/srv/change-detection/catalog/hebei-test-up-linux
SERVER_MODEL_DIR=/srv/change-detection/models
SERVER_BOUNDARY_DIR=/srv/change-detection/platform/data/boundaries
# Empty directory is allowed: the UI then reports that POI data is not configured.
# Put licensed local *.geojson Point data here; the container mounts it read-only.
SERVER_POI_DIR=/srv/change-detection/poi
# Use a new dedicated local-disk directory; do not store SQLite on SMB/NFS.
SERVER_DATA_DIR=/srv/change-detection/runtime
HTTP_PORT=8088
GPU_COUNT=1
PY_MEMORY_LIMIT=8g
PY_CPUS=4
PY_SHM_SIZE=1g
GO_MEMORY_LIMIT=2g
GO_CPUS=2
TILE_RENDER_CONCURRENCY=2
TILE_MAX_PENDING=4
TILE_QUEUE_WAIT_MS=1000
TILE_DATASET_HANDLES=4
TILE_GDAL_CACHE_MB=64

# Optional PUBLIC build-time XYZ basemap settings; empty means default OSM.
# Custom tiles must be WGS84 datum / EPSG:3857 and declare attribution.
# Rebuild the frontend image after changing these values. NEVER put secrets here.
VITE_BASEMAP_URL=
VITE_BASEMAP_CRS=
VITE_BASEMAP_DATUM=
VITE_BASEMAP_ATTRIBUTION=
VITE_BASEMAP_MAX_NATIVE_ZOOM=
